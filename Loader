        function tabApi:AddToggle(cfgT)
            cfgT = cfgT or {}
            local label = cfgT.Text or cfgT.Name or "Toggle"
            local default = cfgT.Default or false
            local cb = cfgT.Callback or function() end

            local holder = new("Frame", {
                Name = "Toggle",
                BackgroundColor3 = Palette.Panel2,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 30),
                ZIndex = 5,
                Parent = page,
            })
            corner(holder, 6)
            stroke(holder, Palette.StrokeSoft, 1, 0.2)

            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -60, 1, 0),
                Font = Enum.Font.Gotham,
                Text = label,
                TextColor3 = Palette.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 6,
                Parent = holder,
            })

            local switch = new("Frame", {
                BackgroundColor3 = Palette.Panel3,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(34, 18),
                ZIndex = 6,
                Parent = holder,
            })
            corner(switch, 9)

            local knob = new("Frame", {
                BackgroundColor3 = Palette.TextDim,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 2, 0.5, -6),
                Size = UDim2.fromOffset(12, 12),
                ZIndex = 7,
                Parent = switch,
            })
            corner(knob, 6)

            local toggled = default

            local function render()
                if toggled then
                    switch.BackgroundColor3 = Palette.Accent
                    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    tween(knob, 0.14, { Position = UDim2.new(1, -14, 0.5, -6) })
                else
                    switch.BackgroundColor3 = Palette.Panel3
                    knob.BackgroundColor3 = Palette.TextDim
                    tween(knob, 0.14, { Position = UDim2.new(0, 2, 0.5, -6) })
                end
            end
            render()

            local tabApiToggle = {}
            tabApiToggle.Set = function(v)
                toggled = v and true or false
                render()
                pcall(cb, toggled)
            end
            tabApiToggle.Get = function() return toggled end

            holder.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    tabApiToggle.Set(not toggled)
                end
            end)

            return tabApiToggle
        end

        function tabApi:AddSlider(cfgS)
            cfgS = cfgS or {}
            local label = cfgS.Text or cfgS.Name or "Slider"
            local minV = cfgS.Min or 0
            local maxV = cfgS.Max or 100
            local default = cfgS.Default or minV
            local cb = cfgS.Callback or function() end
            local decimals = cfgS.Decimals or 0

            local holder = new("Frame", {
                Name = "Slider",
                BackgroundColor3 = Palette.Panel2,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 44),
                ZIndex = 5,
                Parent = page,
            })
            corner(holder, 6)
            stroke(holder, Palette.StrokeSoft, 1, 0.2)

            local lbl = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 4),
                Size = UDim2.new(1, -20, 0, 16),
                Font = Enum.Font.Gotham,
                Text = label,
                TextColor3 = Palette.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 6,
                Parent = holder,
            })
            local valLbl = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 4),
                Size = UDim2.new(1, -20, 0, 16),
                Font = Enum.Font.GothamMedium,
                Text = tostring(default),
                TextColor3 = Palette.Accent,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 6,
                Parent = holder,
            })

            local barBg = new("Frame", {
                BackgroundColor3 = Palette.Panel3,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 10, 1, -16),
                Size = UDim2.new(1, -20, 0, 6),
                ZIndex = 6,
                Parent = holder,
            })
            corner(barBg, 3)

            local barFill = new("Frame", {
                BackgroundColor3 = Palette.Accent,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 0, 1, 0),
                ZIndex = 7,
                Parent = barBg,
            })
            corner(barFill, 3)

            local value = math.clamp(default, minV, maxV)
            local dragging = false

            local function render()
                local alpha = (maxV == minV) and 0 or ((value - minV) / (maxV - minV))
                barFill.Size = UDim2.new(alpha, 0, 1, 0)
                local txt
                if decimals <= 0 then
                    txt = tostring(math.floor(value + 0.5))
                else
                    txt = string.format("%." .. decimals .. "f", value)
                end
                valLbl.Text = txt
            end

            local function setFromX(absX)
                local rel = (absX - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X
                rel = math.clamp(rel, 0, 1)
                local raw = minV + (maxV - minV) * rel
                if decimals <= 0 then
                    value = math.floor(raw + 0.5)
                else
                    local m = 10 ^ decimals
                    value = math.floor(raw * m + 0.5) / m
                end
                render()
                pcall(cb, value)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            render()

            return {
                Set = function(v)
                    value = math.clamp(v, minV, maxV)
                    render()
                    pcall(cb, value)
                end,
                Get = function() return value end,
            }
        end

        function tabApi:AddDropdown(cfgD)
            cfgD = cfgD or {}
            local label = cfgD.Text or cfgD.Name or "Dropdown"
            local options = cfgD.Options or {}
            local cb = cfgD.Callback or function() end

            local holder = new("Frame", {
