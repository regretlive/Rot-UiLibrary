function RotUI:ShortcutManager(parent)
	local host = containerFrame(parent)
	local self_ = self

	local wrap = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.BgElev,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(host),
	})
	wrap.Parent = host
	corner(wrap, M.Radius)
	stroke(wrap, Theme.StrokeSoft, 1)
	pad(wrap, M.Pad)
	list(wrap, M.Gap)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "Shortcuts",
		TextColor3 = Theme.Text,
		Font = Theme.FontBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = wrap,
	})

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = "Toggle visibility on the floating rail. Tap the orb when minimized.",
		TextColor3 = Theme.TextDim,
		Font = Theme.Font,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = wrap,
	})

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(wrap),
	})
	holder.Parent = wrap
	list(holder, 4)

	local function refresh()
		for _, c in ipairs(holder:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		if #self_._shortcuts == 0 then
			local empty = new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Text = "(no shortcuts registered yet)",
				TextColor3 = Theme.TextMute,
				Font = Theme.Font,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			empty.Parent = holder
			return
		end
		for i, s in ipairs(self_._shortcuts) do
			local r = new("Frame", {
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundColor3 = Theme.BgInput,
				BorderSizePixel = 0,
				LayoutOrder = i,
			})
			r.Parent = holder
			corner(r, 6)
			new("TextLabel", {
				Size = UDim2.new(1, -50, 1, 0),
				Position = UDim2.fromOffset(10, 0),
				BackgroundTransparency = 1,
				Text = s._btn:FindFirstChildOfClass("TextLabel").Text,
				TextColor3 = Theme.Text,
				Font = Theme.Font,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = r,
			})

			local pill = new("TextButton", {
				Size = UDim2.fromOffset(36, 18),
				Position = UDim2.new(1, -46, 0.5, -9),
				BackgroundColor3 = s._enabled and Theme.Good or Theme.Stroke,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
			})
			pill.Parent = r
			corner(pill, 9)

			local knob = new("Frame", {
				Size = UDim2.fromOffset(14, 14),
				Position = s._enabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
				BackgroundColor3 = Theme.Text,
				BorderSizePixel = 0,
			})
			knob.Parent = pill
			corner(knob, 7)

			track(pill.MouseButton1Click:Connect(function()
				s._enabled = not s._enabled
				s._btn.Visible = s._enabled
				tween(pill, { BackgroundColor3 = s._enabled and Theme.Good or Theme.Stroke }, 0.16)
				tween(knob, { Position = s._enabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }, 0.16)
				if self_._shortcutOpen then self_:ToggleShortcuts() self_:ToggleShortcuts() end
			end))
		end
	end

	refresh()
	return {
		Refresh = refresh,
		Instance = wrap,
	}
end

-- ============================================================
-- Modal
-- ============================================================
function RotUI:Modal(cfg)
	cfg = cfg or {}
	local self_ = self
	local modal = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Visible = true,
		ZIndex = 400,
	})
	modal.Parent = self.gui

	local card = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(cfg.Width or 360, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.BgElev,
		BorderSizePixel = 0,
		ZIndex = 401,
	})
	card.Parent = modal
	corner(card, M.Radius)
	stroke(card, Theme.Stroke, 1)
	pad(card, M.Pad)
	list(card, M.Gap)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = cfg.Title or "Confirm",
		TextColor3 = Theme.Text,
		Font = Theme.FontBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	if cfg.Text then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = Theme.TextDim,
			Font = Theme.Font,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
	end

	local btnRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Parent = card,
	})
	list(btnRow, 8, Enum.FillDirection.Horizontal,
		Enum.SortOrder.LayoutOrder, Enum.HorizontalAlignment.Right)

	local function close()
		tween(modal, { BackgroundTransparency = 1 }, 0.18)
		tween(card, { Size = UDim2.fromOffset(cfg.Width or 360, 0) }, 0.18)
		task.delay(0.18, function() pcall(function() modal:Destroy() end) end)
	end

	local function mkBtn(txt, primary, cb)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(96, 30),
			BackgroundColor3 = primary and Theme.Accent or Theme.BgInput,
			BorderSizePixel = 0,
			Text = txt,
			TextColor3 = Theme.Text,
			Font = Theme.Font,
			TextSize = 12,
			AutoButtonColor = false,
		})
		b.Parent = btnRow
		corner(b, M.RadiusSm)
		stroke(b, primary and Theme.AccentSoft or Theme.Stroke, 1)
		track(b.MouseButton1Click:Connect(function()
			if cb then pcall(cb) end
			close()
		end))
		return b
	end

	mkBtn(cfg.CancelText or "Cancel", false, cfg.OnCancel)
	mkBtn(cfg.ConfirmText or "OK", true, cfg.OnConfirm)

	return { Close = close, Modal = modal }
end

-- ============================================================
-- config save / load (per-component)
-- ============================================================
function RotUI:RegisterConfig(key, getter, setter)
	self._config[key] = { get = getter, set = setter }
end

function RotUI:SaveConfig(path)
	path = path or self._configPath
	local out = {}
	for k, v in pairs(self._config) do
		local ok, val = pcall(v.get)
		if ok then out[k] = val end
	end
	local json = HttpService:JSONEncode(out)
	if writefile then
		pcall(writefile, path, json)
	else
		self:Notify:Warn("Config", "writefile unavailable in this executor")
	end
end

function RotUI:LoadConfig(path)
	path = path or self._configPath
	if not (isfile and readfile) then
		self:Notify:Warn("Config", "readfile unavailable in this executor")
		return
	end
	if not isfile(path) then return end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then return end
	for k, v in pairs(data) do
		local entry = self._config[k]
		if entry and entry.set then pcall(entry.set, v) end
	end
	self:Notify:Success("Config", "Loaded from " .. path)
end

-- ============================================================
-- exit
-- ============================================================
function RotUI:Destroy()
	if self._destroyed then return end
	self._destroyed = true
	disconnectAll()
	pcall(function() self.gui:Destroy() end)
end

return RotUI
