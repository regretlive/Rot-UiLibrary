-- ============================================================
-- helpers
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or M.RadiusSm), Parent = parent })
end

local function stroke(parent, color, thick, trans)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thick or 1,
		Transparency = trans or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(parent, p, p2)
	local a = p
	local b = p2 or p
	return new("UIPadding", {
		PaddingTop = UDim.new(0, a),
		PaddingBottom = UDim.new(0, a),
		PaddingLeft = UDim.new(0, b),
		PaddingRight = UDim.new(0, b),
		Parent = parent,
	})
end

local function list(parent, padding, dir, order, align)
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or M.Gap),
		SortOrder = order or Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		Parent = parent,
	})
end

local function isMobile()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function isTouch()
	return UserInputService.TouchEnabled
end

local function scale(n, mul)
	if isMobile() then return math.floor(n * (mul or 1.1)) end
	return n
end

local function tween(inst, props, time, style, dir)
	local t = TS:Create(inst, TweenInfo.new(
		time or 0.18,
		style or Enum.EasingStyle.Quart,
		dir or Enum.EasingDirection.Out
	), props)
	t:Play()
	return t
end

local function rgbToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5))
end

local function hexToRgb(hex)
	hex = hex:gsub("#", "")
	local r = tonumber(hex:sub(1, 2), 16) or 0
	local g = tonumber(hex:sub(3, 4), 16) or 0
	local b = tonumber(hex:sub(5, 6), 16) or 0
	return Color3.fromRGB(r, g, b)
end

local function hsvToRgb(h, s, v)
	return Color3.fromHSV(h, s, v)
end

local function rgbToHsv(c)
	return Color3.toHSV(c)
end

-- global signal registry so we can nuke everything on destroy
local Connections = {}
local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function disconnectAll()
	for _, c in ipairs(Connections) do
		pcall(function() c:Disconnect() end)
	end
	Connections = {}
end

-- ============================================================
-- drag factory
-- ============================================================
local function makeDraggable(frame, handle, opts)
	opts = opts or {}
	handle = handle or frame
	local dragging, dragStart, startPos
	local onStart = opts.OnStart
	local onEnd = opts.OnEnd
	local onMove = opts.OnMove

	local function begin(input)
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		if onStart then onStart() end
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if onEnd then onEnd() end
			end
		end)
	end

	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			begin(input)
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			local np = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			frame.Position = np
			if onMove then onMove(np) end
		end
	end))
end

-- ============================================================
-- resize factory
-- ============================================================
local function makeResizable(frame, minW, minH, maxW, maxH, onResize)
	local grip = new("Frame", {
		Name = "ResizeGrip",
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(1, -24, 1, -24),
		BackgroundColor3 = Theme.BgElev2,
		BackgroundTransparency = 0.3,
		ZIndex = 5,
	})
	grip.Parent = frame
	corner(grip, 6)
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "◢",
		TextColor3 = Theme.TextDim,
		Font = Theme.FontBold,
		TextSize = 12,
		Parent = grip,
	})

	local resizing, resizeStart, startSize

	track(grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizeStart = input.Position
			startSize = frame.AbsoluteSize
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					if onResize then onResize(frame.AbsoluteSize) end
				end
			end)
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not resizing then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - resizeStart
			local w = math.clamp(startSize.X + delta.X, minW or 320, maxW or 1600)
			local h = math.clamp(startSize.Y + delta.Y, minH or 240, maxH or 1000)
			frame.Size = UDim2.fromOffset(w, h)
		end
	end))

	return grip
end

-- ============================================================
-- notification system (module-scoped, per RotUI instance)
-- ============================================================
local Notify = {}
Notify.__index = Notify

function Notify.new(host)
	local self = setmetatable({}, Notify)
	self._host = host
	self._stack = new("Frame", {
		Name = "NotifyStack",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(M.NotifyW, 0),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 200,
	})
	self._stack.Parent = host
	list(self._stack, M.PadSm, Enum.FillDirection.Vertical, Enum.SortOrder.LayoutOrder)
	return self
end

function Notify:Push(cfg)
	cfg = cfg or {}
	local kind = cfg.Type or "info"
	local title = cfg.Title or "Notification"
	local body = cfg.Text or cfg.Body or ""
	local duration = cfg.Duration or 5

	local accent = Theme.Accent
	if kind == "success" then accent = Theme.Good
	elseif kind == "warn" or kind == "warning" then accent = Theme.Warn
	elseif kind == "error" or kind == "bad" then accent = Theme.Bad
	end

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.BgElev,
		BorderSizePixel = 0,
		BackgroundTransparency = 0.05,
		LayoutOrder = -math.floor(os.clock() * 1000),
		ClipsDescendants = true,
	})
	card.Parent = self._stack
	corner(card, M.Radius)
	stroke(card, Theme.Stroke, 1)

	local bar = new("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
	})
	bar.Parent = card
	corner(bar, 2)

	local inner = new("Frame", {
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.fromOffset(14, 0),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	inner.Parent = card
	pad(inner, 10, 0)
	list(inner, 4)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = Theme.Text,
		Font = Theme.FontBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = inner,
	})

	if body ~= "" then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = body,
			TextColor3 = Theme.TextDim,
			Font = Theme.Font,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = inner,
		})
	end

	local pbar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
	})
	pbar.Parent = card

	card.Size = UDim2.new(1, 0, 0, 0)
	card.Position = UDim2.new(0, 30, 0, 0)
	tween(card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.05 }, 0.25)

	local lifetime = math.max(0.5, duration)
	tween(pbar, { Size = UDim2.new(0, 0, 0, 2) }, lifetime, Enum.EasingStyle.Linear)

	local dismissed = false
	local function dismiss()
		if dismissed then return end
		dismissed = true
		local t1 = tween(card, { Position = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, 0.2)
		t1.Completed:Connect(function()
			pcall(function() card:Destroy() end)
		end)
	end

	task.delay(lifetime, dismiss)
	card.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dismiss()
		end
	end)

	return {
		Dismiss = dismiss,
		Card = card,
	}
end

function Notify:Info(t, b, d) return self:Push({ Type = "info", Title = t, Text = b, Duration = d }) end
function Notify:Success(t, b, d) return self:Push({ Type = "success", Title = t, Text = b, Duration = d }) end
function Notify:Warn(t, b, d) return self:Push({ Type = "warn", Title = t, Text = b, Duration = d }) end
function Notify:Error(t, b, d) return self:Push({ Type = "error", Title = t, Text = b, Duration = d }) end

-- ============================================================
-- tooltip registry (single shared card)
-- ============================================================
local function attachTooltip(target, text)
	if not text or text == "" then return end
	local gui = target:FindFirstAncestorWhichIsA("ScreenGui") or target:FindFirstAncestorWhichIsA("LayerCollector")
	local card
	local show, hide

	show = function()
		if card then return end
		card = new("Frame", {
			Size = UDim2.fromOffset(M.TooltipW, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.BgElev2,
			BorderSizePixel = 0,
			ZIndex = 300,
			Visible = false,
		})
		card.Parent = gui
		corner(card, M.RadiusSm)
		stroke(card, Theme.Stroke, 1)
		pad(card, 6, 8)
		local lbl = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = Theme.Text,
			Font = Theme.Font,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		lbl.Parent = card
		task.defer(function()
			local ap = target.AbsolutePosition
			local as = target.AbsoluteSize
			card.Position = UDim2.fromOffset(
				math.clamp(ap.X + as.X / 2 - M.TooltipW / 2, 6, workspace.CurrentCamera.ViewportSize.X - M.TooltipW - 6),
				ap.Y - card.AbsoluteSize.Y - 8
			)
			card.Visible = true
		end)
	end

	hide = function()
		if card then
			pcall(function() card:Destroy() end)
			card = nil
		end
	end

	track(target.MouseEnter:Connect(show))
	track(target.MouseLeave:Connect(hide))
end

