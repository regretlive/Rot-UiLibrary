local Rot = {}
Rot.__index = Rot

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local CoreGui           = game:GetService("CoreGui")

local LocalPlayer       = Players.LocalPlayer

local Theme = {
    Background      = Color3.fromRGB(20, 20, 24),
    Surface         = Color3.fromRGB(28, 28, 33),
    SurfaceAlt      = Color3.fromRGB(36, 36, 42),
    Stroke          = Color3.fromRGB(50, 50, 58),
    Text            = Color3.fromRGB(240, 240, 245),
    TextDim         = Color3.fromRGB(150, 150, 160),
    Accent          = Color3.fromRGB(120, 90, 255),
    AccentDim       = Color3.fromRGB(90, 65, 200),
    Danger          = Color3.fromRGB(230, 80, 90),
    Shadow          = Color3.fromRGB(0, 0, 0),
}

local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
local SCALE     = IS_MOBILE and 0.85 or 1

local function nukeRot()
    local roots = {}
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function() table.insert(roots, LocalPlayer:FindFirstChild("PlayerGui")) end)

    for _, root in ipairs(roots) do
        if root then
            for _, child in ipairs(root:GetChildren()) do
                local n = child.Name
                if child:IsA("ScreenGui")
                and (n == "RotUI" or n:sub(1, 6) == "RotUI_") then
                    pcall(function() child.Enabled = false end)
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    for _, reg in ipairs({ _G, getgenv and getgenv() or nil, shared }) do
        if reg and reg.Rot then
            pcall(function()
                if type(reg.Rot.Destroy) == "function" then reg.Rot:Destroy() end
                if type(reg.Rot.Close)   == "function" then reg.Rot:Close()   end
            end)
            reg.Rot = nil
        end
    end
end

nukeRot()

local function getParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function new(inst, props)
    local o = Instance.new(inst)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(parent, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function pad(parent, t, r, b, l)
    return new("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingRight  = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft   = UDim.new(0, l or r or t or 0),
        Parent = parent,
    })
end

local function tween(inst, time, props, style, dir)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function makeDraggable(frame, handle, onRelease)
    handle = handle or frame
    local dragging, dragStart, startPos = false, nil, nil
    local moved = false

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if onRelease then onRelease(moved) end
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then moved = true end
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function windowButton(parent, glyph, hoverColor)
    local btn = new("TextButton", {
        Name = "WinBtn_" .. glyph,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(36, 28),
        Font = Enum.Font.Gotham,
        Text = glyph,
        TextColor3 = Theme.TextDim,
        TextSize = 14,
        AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, 6)

    btn.MouseEnter:Connect(function()
        tween(btn, 0.12, { BackgroundTransparency = 0, BackgroundColor3 = hoverColor or Theme.SurfaceAlt })
        tween(btn, 0.12, { TextColor3 = Theme.Text })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.12, { BackgroundTransparency = 1 })
        tween(btn, 0.12, { TextColor3 = Theme.TextDim })
    end)

    return btn
end

function Rot:CreateWindow(cfg)
    cfg = cfg or {}
    local title    = cfg.Title or "Rot"
    local subtitle = cfg.Subtitle or "UI Library"
    local baseSize = cfg.Size or UDim2.fromOffset(600, 400)
    local size     = UDim2.fromOffset(
        math.floor(baseSize.X.Offset * SCALE),
        math.floor(baseSize.Y.Offset * SCALE)
    )
    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    local parent    = cfg.Parent or getParent()

    local gui = new("ScreenGui", {
        Name = "RotUI_" .. tostring(math.random(1e6, 9e6)),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 9999,
        Parent = parent,
    })

    local shadow = new("Frame", {
        Name = "Shadow",
        BackgroundColor3 = Theme.Shadow,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 6, 0, 6),
        Size = size,
        ZIndex = 0,
        Parent = gui,
    })
    corner(shadow, 14)

    local win = new("Frame", {
        Name = "Window",
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Size = size,
        Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 2,
        Parent = gui,
    })
    corner(win, 12)
    stroke(win, Theme.Stroke, 1, 0.2)

    new("Frame", {
        Name = "Accent",
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 2),
        ZIndex = 3,
        Parent = win,
    })

    local titleBar = new("Frame", {
        Name = "TitleBar",
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 42),
        ZIndex = 3,
        Parent = win,
    })

    new("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(0.5, 0, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
        Parent = titleBar,
    })

    local btnRail = new("Frame", {
        Name = "BtnRail",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 7),
        Size = UDim2.fromOffset(120, 28),
        ZIndex = 4,
        Parent = titleBar,
    })

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
        Parent = btnRail,
    })

    local minBtn   = windowButton(btnRail, "—", Theme.SurfaceAlt)
    local maxBtn   = windowButton(btnRail, "▢", Theme.SurfaceAlt)
    local closeBtn = windowButton(btnRail, "✕", Theme.Danger)

    local body = new("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 42),
        Size = UDim2.new(1, 0, 1, -42),
        ZIndex = 3,
        Parent = win,
    })
    pad(body, 10)

    local state = {
        Minimized = false,
        Fullscreen = false,
        Visible = false,
        OriginalSize = size,
        OriginalPos = win.Position,
    }

    minBtn.MouseButton1Click:Connect(function()
        state.Minimized = not state.Minimized
        body.Visible = not state.Minimized
        local target = state.Minimized and UDim2.new(0, size.X.Offset, 0, 42) or size
        tween(win, 0.2, { Size = target })
        tween(shadow, 0.2, { Size = target })
    end)

    maxBtn.MouseButton1Click:Connect(function()
        state.Fullscreen = not state.Fullscreen
        if state.Fullscreen then
            state.OriginalSize = win.Size
            state.OriginalPos = win.Position
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            local w, h = math.floor(vp.X * 0.9), math.floor(vp.Y * 0.9)
            tween(win, 0.22, {
                Size = UDim2.fromOffset(w, h),
                Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2),
            })
            tween(shadow, 0.22, {
                Size = UDim2.fromOffset(w, h),
                Position = UDim2.new(0.5, -w / 2 + 6, 0.5, -h / 2 + 6),
            })
        else
            tween(win, 0.22, { Size = state.OriginalSize, Position = state.OriginalPos })
            tween(shadow, 0.22, {
                Size = state.OriginalSize,
                Position = UDim2.new(
                    state.OriginalPos.X.Scale, state.OriginalPos.X.Offset + 6,
                    state.OriginalPos.Y.Scale, state.OriginalPos.Y.Offset + 6
                ),
            })
        end
    end)

    local function setVisible(v)
        state.Visible = v
        if v then
            win.Visible = true
            win.Size = UDim2.new(0, size.X.Offset, 0, 0)
            tween(win, 0.18, { Size = size })
            tween(shadow, 0.18, { Size = size })
        else
            tween(win, 0.15, { Size = UDim2.new(0, size.X.Offset, 0, 0) })
            tween(shadow, 0.15, { Size = UDim2.new(0, size.X.Offset, 0, 0) })
            task.delay(0.16, function()
                if not state.Visible then win.Visible = false end
            end)
        end
    end

    closeBtn.MouseButton1Click:Connect(function()
        setVisible(false)
    end)

    makeDraggable(win, titleBar)

    if toggleKey and not IS_MOBILE then
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == toggleKey then setVisible(not state.Visible) end
        end)
    end

    local bubbleSize = IS_MOBILE and 56 or 48
    local bubble = new("TextButton", {
        Name = "ToggleBubble",
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(bubbleSize, bubbleSize),
        Position = UDim2.new(0, 24, 0.5, -bubbleSize / 2),
        Text = "R",
        Font = Enum.Font.GothamBold,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = IS_MOBILE and 22 or 18,
        AutoButtonColor = false,
        ZIndex = 10,
        Parent = gui,
    })
    corner(bubble, bubbleSize / 2)
    stroke(bubble, Theme.AccentDim, 2, 0)

    local bubbleShadow = new("Frame", {
        Name = "BubbleShadow",
        BackgroundColor3 = Theme.Shadow,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(bubbleSize, bubbleSize),
        Position = bubble.Position + UDim2.fromOffset(3, 3),
        ZIndex = 9,
        Parent = gui,
    })
    corner(bubbleShadow, bubbleSize / 2)

    bubble.MouseEnter:Connect(function()
        tween(bubble, 0.12, { BackgroundColor3 = Theme.AccentDim })
    end)
    bubble.MouseLeave:Connect(function()
        tween(bubble, 0.12, { BackgroundColor3 = Theme.Accent })
    end)

    makeDraggable(bubble, bubble, function(moved)
        if not moved then
            setVisible(not state.Visible)
        end
    end)

    bubble:GetPropertyChangedSignal("Position"):Connect(function()
        bubbleShadow.Position = bubble.Position + UDim2.fromOffset(3, 3)
    end)

    local Tabs = {}
    local currentTab

    local tabBar = new("Frame", {
        Name = "TabBar",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        ZIndex = 4,
        Parent = body,
    })

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = tabBar,
    })

    local content = new("Frame", {
        Name = "Content",
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 42),
        Size = UDim2.new(1, 0, 1, -42),
        ZIndex = 3,
        Parent = body,
    })
    corner(content, 10)
    stroke(content, Theme.Stroke, 1, 0.5)

    local contentPad = new("ScrollingFrame", {
        Name = "Scroll",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.SurfaceAlt,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = content,
    })

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = contentPad,
    })

    local api = {}
    api.Gui      = gui
    api.Window   = win
    api.Body     = body
    api.Content  = contentPad
    api.Theme    = Theme
    api.State    = state
    api.Bubble   = bubble
    api.Close    = function() setVisible(false) end
    api.Destroy  = function()
        pcall(function() gui.Enabled = false end)
        pcall(function() gui:Destroy() end)
    end

    api.Toggle = function()
        setVisible(not state.Visible)
    end

    function api:AddTab(name)
        name = name or "Tab"

        local btn = new("TextButton", {
            Name = "Tab_" .. name,
            BackgroundColor3 = Theme.SurfaceAlt,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(#name * 8 + 24, 28),
            Font = Enum.Font.GothamMedium,
            Text = name,
            TextColor3 = Theme.TextDim,
            TextSize = 12,
            AutoButtonColor = false,
            ZIndex = 5,
            Parent = tabBar,
        })
        corner(btn, 8)

        local page = new("Frame", {
            Name = "Page_" .. name,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 4,
            Visible = false,
            Parent = contentPad,
        })

        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
            Parent = page,
        })

        local tabApi = {}
        tabApi.Page = page
        tabApi.Button = btn

        function tabApi:AddLabel(text)
            local lbl = new("TextLabel", {
                Name = "Label",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
                Font = Enum.Font.Gotham,
                Text = text or "",
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5,
                Parent = page,
            })
            return lbl
        end

        function tabApi:Select()
            for _, t in ipairs(Tabs) do
                t.Button.BackgroundColor3 = Theme.SurfaceAlt
                t.Button.TextColor3 = Theme.TextDim
                t.Page.Visible = false
            end
            btn.BackgroundColor3 = Theme.Accent
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            page.Visible = true
            currentTab = tabApi
        end

        btn.MouseButton1Click:Connect(function() tabApi:Select() end)

        table.insert(Tabs, tabApi)
        if not currentTab then tabApi:Select() end
        return tabApi
    end

    api.Tabs = Tabs
    api.SelectTab = function(name)
        for _, t in ipairs(Tabs) do
            if t.Button.Text == name then t:Select() return end
        end
    end

    Rot.Instance = api
    _G.Rot = Rot
    if getgenv then getgenv().Rot = Rot end
    if shared then shared.Rot = Rot end

    return api, Rot
end

return Rot
