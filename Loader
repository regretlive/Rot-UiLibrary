    local title    = cfg.Title or "Rot"
    local subtitle = cfg.Subtitle or ""
    local baseW    = (cfg.Width  or 460)
    local baseH    = (cfg.Height or 300)
    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
