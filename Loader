local function reg()
    if getgenv then
        local g = getgenv()
        g[LIVE_REGISTRY_KEY] = g[LIVE_REGISTRY_KEY] or {}
        return g[LIVE_REGISTRY_KEY]
    end
    _G[LIVE_REGISTRY_KEY] = _G[LIVE_REGISTRY_KEY] or {}
    return _G[LIVE_REGISTRY_KEY]
end

local function nukeAll()
    local roots = {}
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function() table.insert(roots, LocalPlayer:FindFirstChild("PlayerGui")) end)
    pcall(function() table.insert(roots, game:GetService("Players")) end)

    for _, root in ipairs(roots) do
        if root then
            for _, child in ipairs(root:GetDescendants()) do
                if child:IsA("ScreenGui") and child.Name:sub(1, #PREFIX) == PREFIX then
                    pcall(function() child.Enabled = false end)
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    local live = reg()
    for i = #live, 1, -1 do
        local entry = live[i]
        pcall(function()
            if entry and type(entry.destroy) == "function" then entry.destroy() end
        end)
        live[i] = nil
    end

    for _, holder in ipairs({ _G, getgenv and getgenv() or nil, shared }) do
        if holder then
            if holder.Rot then
                pcall(function()
                    if type(holder.Rot.Destroy) == "function" then holder.Rot:Destroy() end
                end)
                holder.Rot = nil
            end
            if holder[LIVE_REGISTRY_KEY] then holder[LIVE_REGISTRY_KEY] = nil end
        end
    end
end

nukeAll()

local function getParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function new(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(parent, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Palette.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function pad(parent, t, r, b, l)
    return new("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingRight  = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft   = UDim.new(0, l or r or t or 0),
        Parent = parent,
    })
end

local function tween(inst, time, props, style, dir)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(time or 0.16, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function trackConn(bag, conn)
    table.insert(bag, conn)
    return conn
end

local function disconnectAll(bag)
    for _, c in ipairs(bag) do pcall(function() c:Disconnect() end) end
    for i = #bag, 1, -1 do bag[i] = nil end
end

local function makeDraggable(frame, handle, onRelease)
    handle = handle or frame
    local dragging, dragStart, startPos = false, nil, nil
    local moved = false
    local bag = {}

    trackConn(bag, handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = frame.Position
            trackConn(bag, input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if onRelease then onRelease(moved) end
                end
            end))
        end
    end))

    trackConn(bag, handle.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then moved = true end
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    return function() disconnectAll(bag) end
end

local function makeResizable(win, shadow, grip, minW, minH)
    local dragging, startPos, startSize = false, nil, nil
    local bag = {}

    trackConn(bag, grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = input.Position
            startSize = win.AbsoluteSize
            trackConn(bag, input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end))
        end
    end))

    trackConn(bag, grip.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startPos
            local w = math.max(minW, math.floor(startSize.X + delta.X))
            local h = math.max(minH, math.floor(startSize.Y + delta.Y))
            win.Size = UDim2.fromOffset(w, h)
            shadow.Size = UDim2.fromOffset(w, h)
        end
    end))

    return function() disconnectAll(bag) end
end

local function windowButton(parent, glyph, hoverColor, danger)
    local btn = new("TextButton", {
        Name = "Ctrl_" .. glyph,
        BackgroundColor3 = Palette.Panel2,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(28, 22),
        Font = Enum.Font.Gotham,
        Text = glyph,
        TextColor3 = Palette.TextDim,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, 5)

    btn.MouseEnter:Connect(function()
        tween(btn, 0.1, {
            BackgroundTransparency = 0,
            BackgroundColor3 = hoverColor or Palette.Panel3,
            TextColor3 = Palette.Text,
        })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.1, { BackgroundTransparency = 1, TextColor3 = Palette.TextDim })
    end)

    return btn
end

function Rot:CreateWindow(cfg)
