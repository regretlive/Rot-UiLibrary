-- ============================================================
-- shortcut rail + management
-- ============================================================
function RotUI:ToggleShortcuts()
	self._shortcutOpen = not self._shortcutOpen
	local rail = self._rail
	if self._shortcutOpen then
		rail.Visible = true
		local visibleRows = 0
		for _, s in ipairs(self._shortcuts) do
			if s._enabled then visibleRows = visibleRows + 1 end
		end
		local targetH = math.min(300, 12 + visibleRows * (M.RailRowH + 6))
		tween(rail, { Size = UDim2.fromOffset(scale(M.RailW), targetH) }, 0.22)
	else
		tween(rail, { Size = UDim2.fromOffset(scale(M.RailW), 0) }, 0.18)
		task.delay(0.18, function()
			if not self._shortcutOpen then rail.Visible = false end
		end)
	end
end

function RotUI:AddShortcut(cfg)
	cfg = cfg or {}
	local self_ = self

	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, M.RailRowH),
		BackgroundColor3 = Theme.Bg,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Visible = true,
		LayoutOrder = #self._shortcuts + 1,
	})
	btn.Parent = self._railList
	corner(btn, M.RadiusSm)
	stroke(btn, Theme.Stroke, 1)

	new("TextLabel", {
		Size = UDim2.new(1, -14, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = cfg.Text or "Shortcut",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = btn,
	})

	track(btn.MouseEnter:Connect(function()
		tween(btn, { BackgroundColor3 = Theme.Accent }, 0.12)
	end))
	track(btn.MouseLeave:Connect(function()
		tween(btn, { BackgroundColor3 = Theme.Bg }, 0.12)
	end))
	if cfg.Callback then track(btn.MouseButton1Click:Connect(cfg.Callback)) end

	local s = { _btn = btn, _enabled = cfg.Visible ~= false }
	table.insert(self._shortcuts, s)
	return s
end

