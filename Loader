function RotUI:Textbox(parent, cfg)
	cfg = cfg or {}
	local host = containerFrame(parent)

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, M.RowTall),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
		LayoutOrder = cfg.Order or nextOrder(host),
	})
	row.Parent = host
	corner(row, M.RadiusSm)
	stroke(row, Theme.Stroke, 1)

	new("TextLabel", {
		Size = UDim2.new(1, -24, 0, 14),
		Position = UDim2.fromOffset(12, 4),
		BackgroundTransparency = 1,
		Text = cfg.Text or "Input",
		TextColor3 = Theme.TextDim,
		Font = Theme.Font,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local box = new("TextBox", {
		Size = UDim2.new(1, -24, 0, 20),
		Position = UDim2.fromOffset(12, 17),
		BackgroundTransparency = 1,
		Text = cfg.Default or "",
		PlaceholderText = cfg.Placeholder or "",
		PlaceholderColor3 = Theme.TextMute,
		TextColor3 = Theme.Text,
		Font = Theme.FontMono,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = row,
	})

	local function commit()
		local v = box.Text
		if cfg.Numeric then
			local n = tonumber(v)
			if n then box.Text = tostring(n) end
		end
		if cfg.Callback then
			local ok, err = pcall(cfg.Callback, box.Text)
			if not ok then warn("[RotUI] textbox callback: " .. tostring(err)) end
		end
	end

	track(box.FocusLost:Connect(commit))
	track(box.FocusGained:Connect(function()
		tween(row, { BackgroundColor3 = Theme.BgElev2 }, 0.1)
	end))
	track(box.FocusLost:Connect(function()
		tween(row, { BackgroundColor3 = Theme.BgInput }, 0.1)
	end))
	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end

	return {
		Set = function(v) box.Text = tostring(v) end,
		Get = function() return box.Text end,
		Instance = box,
	}
end

-- ------------------------------------------------------------
-- Keybind
-- ------------------------------------------------------------
function RotUI:Keybind(parent, cfg)
	cfg = cfg or {}
	local host = containerFrame(parent)
	local current = cfg.Default or Enum.KeyCode.Unknown
	local listening = false

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, M.Row),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
		LayoutOrder = cfg.Order or nextOrder(host),
	})
	row.Parent = host
	corner(row, M.RadiusSm)
	stroke(row, Theme.Stroke, 1)

	new("TextLabel", {
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text = cfg.Text or "Keybind",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local keyBtn = new("TextButton", {
		Size = UDim2.fromOffset(96, 22),
		Position = UDim2.new(1, -108, 0.5, -11),
		BackgroundColor3 = Theme.Bg,
		BorderSizePixel = 0,
		Text = current.Name,
		TextColor3 = Theme.Text,
		Font = Theme.FontMono,
		TextSize = 11,
		AutoButtonColor = false,
	})
	keyBtn.Parent = row
	corner(keyBtn, 6)
	stroke(keyBtn, Theme.Stroke, 1)

	local function apply(k, silent)
		current = k
		keyBtn.Text = k.Name
		if not silent and cfg.Callback then
			pcall(cfg.Callback, k)
		end
	end

	track(keyBtn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		keyBtn.Text = "…"
		tween(keyBtn, { BackgroundColor3 = Theme.Accent }, 0.1)

		local conn
		conn = UserInputService.InputBegan:Connect(function(input, gp)
			if gp then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				conn:Disconnect()
				tween(keyBtn, { BackgroundColor3 = Theme.Bg }, 0.1)
				apply(input.KeyCode)
			end
		end)
		track(conn)

		task.delay(5, function()
			if listening then
				listening = false
				pcall(function() conn:Disconnect() end)
				tween(keyBtn, { BackgroundColor3 = Theme.Bg }, 0.1)
				keyBtn.Text = current.Name
			end
		end)
	end))

	track(UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if listening then return end
		if input.KeyCode == current and cfg.OnPress then
			pcall(cfg.OnPress)
		end
	end))

	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end

	return {
		Set = apply,
		Get = function() return current end,
		Instance = row,
	}
end

