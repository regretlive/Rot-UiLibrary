    corner(shadow, 10)

    local win = new("Frame", {
        Name = "Window",
        BackgroundColor3 = Palette.Bg,
        BorderSizePixel = 0,
        Size = size,
        Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2),
