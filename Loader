                Parent = header,
            })

            local currentLbl = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -40, 1, 0),
                Font = Enum.Font.GothamMedium,
                Text = "none",
                TextColor3 = Palette.TextDim,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 6,
                Parent = header,
            })

            local arrow = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -22, 0, 0),
                Size = UDim2.fromOffset(18, 30),
                Font = Enum.Font.GothamBold,
                Text = "▾",
                TextColor3 = Palette.TextFaint,
                TextSize = 10,
                ZIndex = 6,
                Parent = header,
            })

            local list = new("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 30),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 6,
                Parent = holder,
            })
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
                Parent = list,
            })
            pad(list, 4, 6, 6, 6)

            local open = false
            local selected

            local function render()
                currentLbl.Text = selected or "none"
                arrow.Text = open and "▴" or "▾"
                if open then
                    local targetH = 30 + (list.AbsoluteSize.Y > 0 and list.AbsoluteSize.Y or (#options * 26 + 10))
                    tween(holder, 0.16, { Size = UDim2.new(1, 0, 0, targetH) })
                else
                    tween(holder, 0.16, { Size = UDim2.new(1, 0, 0, 30) })
                end
            end

            for _, opt in ipairs(options) do
                local ob = new("TextButton", {
                    BackgroundColor3 = Palette.Panel3,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                    Font = Enum.Font.Gotham,
                    Text = tostring(opt),
                    TextColor3 = Palette.TextDim,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 6,
                    Parent = list,
                })
                pad(ob, 0, 0, 0, 8)
                corner(ob, 4)
                ob.MouseEnter:Connect(function()
                    ob.BackgroundTransparency = 0
                end)
                ob.MouseLeave:Connect(function()
                    ob.BackgroundTransparency = 1
                end)
                ob.MouseButton1Click:Connect(function()
                    selected = tostring(opt)
                    render()
                    pcall(cb, selected)
                end)
            end

            header.MouseButton1Click:Connect(function()
                open = not open
                render()
            end)

            return {
                Set = function(v)
                    selected = tostring(v)
                    render()
                    pcall(cb, selected)
                end,
                Get = function() return selected end,
                SetOptions = function(newOpts)
                    options = newOpts or {}
                end,
            }
        end

        btn.MouseButton1Click:Connect(function() tabApi:Select() end)

        table.insert(tabs, tabApi)
        if not currentTab then tabApi:Select() end
        return tabApi
    end

    local entry = {
        destroy = api.Destroy,
        gui = gui,
    }
    table.insert(reg(), entry)

    Rot.Instance = api
    _G.Rot = Rot
    if getgenv then getgenv().Rot = Rot end
    if shared then shared.Rot = Rot end

    return api, Rot
end

