
--[[
    ClassicUI - Version 1.0
    Standard Roblox client UI library
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ClassicUI = {}
ClassicUI.__index = ClassicUI

local COLORS = {
    Background = Color3.fromRGB(18, 19, 24),
    Sidebar = Color3.fromRGB(22, 23, 29),
    Surface = Color3.fromRGB(29, 31, 39),
    Hover = Color3.fromRGB(39, 42, 52),
    Text = Color3.fromRGB(237, 239, 246),
    Muted = Color3.fromRGB(145, 150, 166),
    Accent = Color3.fromRGB(75, 135, 255),
    Border = Color3.fromRGB(48, 51, 62),
}

local function create(className, properties, parent)
    local obj = Instance.new(className)

    for key, value in pairs(properties or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function stroke(parent, color, transparency)
    return create("UIStroke", {
        Color = color or COLORS.Border,
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function tween(object, duration, properties)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )
    animation:Play()
    return animation
end

local function label(parent, text, size, position, dimensions)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = COLORS.Text,
        TextSize = size or 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = position or UDim2.new(),
        Size = dimensions or UDim2.new(1, 0, 0, 24),
    }, parent)
end

-- Window creation

function ClassicUI.new(config)
    config = config or {}

    -- Remove a previous copy made by this library.
    local previous = PlayerGui:FindFirstChild("ClassicUI")
    if previous then
        previous:Destroy()
    end

    local self = setmetatable({}, ClassicUI)

    self.Tabs = {}
    self.Connections = {}
    self.Visible = true
    self.Destroyed = false
    self.ActiveTab = nil
    self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    self.Accent = config.Accent or COLORS.Accent
    self.RGB = config.RGB ~= false

    self.Screen = create("ScreenGui", {
        Name = "ClassicUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, PlayerGui)

    self.Main = create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(
            config.Width or 650,
            config.Height or 420
        ),
        Position = UDim2.new(0.5, -325, 0.5, -210),
        BackgroundColor3 = COLORS.Background,
        BorderSizePixel = 0,
    }, self.Screen)

    corner(self.Main, 10)
    stroke(self.Main, COLORS.Border)

    -- Title bar

    self.TitleBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = COLORS.Surface,
        BorderSizePixel = 0,
    }, self.Main)

    corner(self.TitleBar, 10)

    -- Cover the bottom title-bar corners for a clean edge.
    create("Frame", {
        Position = UDim2.new(0, 0, 1, -10),
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = COLORS.Surface,
        BorderSizePixel = 0,
    }, self.TitleBar)

    label(
        self.TitleBar,
        config.Title or "ClassicUI",
        16,
        UDim2.fromOffset(16, 0),
        UDim2.new(1, -100, 1, 0)
    ).Font = Enum.Font.GothamBold

    self.Close = create("TextButton", {
        Name = "Close",
        Text = "×",
        TextSize = 25,
        Font = Enum.Font.Gotham,
        TextColor3 = COLORS.Muted,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -43, 0, 5),
        Size = UDim2.fromOffset(36, 36),
    }, self.TitleBar)

    -- Animated accent line

    self.AccentLine = create("Frame", {
        Name = "AccentLine",
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = self.Accent,
        BorderSizePixel = 0,
    }, self.TitleBar)

    -- Sidebar

    self.Sidebar = create("Frame", {
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(0, 175, 1, -48),
        BackgroundColor3 = COLORS.Sidebar,
        BorderSizePixel = 0,
    }, self.Main)

    corner(self.Sidebar, 10)

    create("Frame", {
        Position = UDim2.new(1, -10, 0, 0),
        Size = UDim2.new(0, 10, 1, 0),
        BackgroundColor3 = COLORS.Sidebar,
        BorderSizePixel = 0,
    }, self.Sidebar)

    -- Search input

    self.Search = create("TextBox", {
        Name = "Search",
        PlaceholderText = "Search tabs...",
        Text = "",
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = COLORS.Text,
        PlaceholderColor3 = COLORS.Muted,
        BackgroundColor3 = COLORS.Surface,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, 14),
        Size = UDim2.new(1, -24, 0, 32),
    }, self.Sidebar)

    corner(self.Search, 7)
    stroke(self.Search)

    self.TabList = create("ScrollingFrame", {
        Position = UDim2.fromOffset(10, 57),
        Size = UDim2.new(1, -20, 1, -67),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.Muted,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
    }, self.Sidebar)

    create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.TabList)

    -- Content panel

    self.Content = create("Frame", {
        Position = UDim2.fromOffset(175, 48),
        Size = UDim2.new(1, -175, 1, -48),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, self.Main)

    -- Minimized state can be reopened with the toggle key.

    self.Close.Activated:Connect(function()
        self:SetVisible(false)
    end)

    self.Close.MouseEnter:Connect(function()
        tween(self.Close, 0.15, {
            TextColor3 = Color3.fromRGB(255, 95, 105)
        })
    end)

    self.Close.MouseLeave:Connect(function()
        tween(self.Close, 0.15, {
            TextColor3 = COLORS.Muted
        })
    end)

    table.insert(self.Connections,
        UserInputService.InputBegan:Connect(function(input, processed)
            if processed or self.Destroyed then
                return
            end

            if input.KeyCode == self.ToggleKey then
                self:SetVisible(not self.Visible)
            end
        end)
    )

    table.insert(self.Connections,
        self.Search:GetPropertyChangedSignal("Text"):Connect(function()
            self:FilterTabs(self.Search.Text)
        end)
    )

    if self.RGB then
        table.insert(self.Connections,
            RunService.RenderStepped:Connect(function()
                if self.Destroyed then
                    return
                end

                self.AccentLine.BackgroundColor3 =
                    Color3.fromHSV((os.clock() * 0.12) % 1, 0.75, 1)
            end)
        )
    end

    -- Dragging

    local dragging = false
    local dragStart
    local startPosition

    table.insert(self.Connections,
        self.TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPosition = self.Main.Position
            end
        end)
    )

    table.insert(self.Connections,
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end

            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then

                local delta = input.Position - dragStart
                self.Main.Position = UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            end
        end)
    )

    table.insert(self.Connections,
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    )

    return self
end

function ClassicUI:SetVisible(visible)
    if self.Destroyed then
        return
    end

    self.Visible = visible
    self.Main.Visible = visible
end

function ClassicUI:FilterTabs(query)
    query = string.lower(query or "")

    for _, tab in ipairs(self.Tabs) do
        tab.Button.Visible =
            query == ""
            or string.find(string.lower(tab.Name), query, 1, true) ~= nil
    end
end

-- Tabs

function ClassicUI:CreateTab(name)
    assert(not self.Destroyed, "This UI has been destroyed")

    local tab = {
        Name = name,
        Library = self,
    }

    tab.Button = create("TextButton", {
        Name = name .. "Tab",
        Text = name,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextColor3 = COLORS.Muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundColor3 = COLORS.Sidebar,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 34),
    }, self.TabList)

    create("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
    }, tab.Button)

    tab.Page = create("ScrollingFrame", {
        Name = name .. "Page",
        Position = UDim2.fromOffset(14, 12),
        Size = UDim2.new(1, -28, 1, -24),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.Muted,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, self.Content)

    create("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tab.Page)

    function tab:Activate()
        for _, other in ipairs(self.Library.Tabs) do
            other.Page.Visible = false
            tween(other.Button, 0.15, {
                BackgroundTransparency = 1,
                TextColor3 = COLORS.Muted,
            })
        end

        self.Page.Visible = true
        self.Library.ActiveTab = self

        tween(self.Button, 0.15, {
            BackgroundTransparency = 0,
            BackgroundColor3 = COLORS.Hover,
            TextColor3 = COLORS.Text,
        })
    end

    tab.Button.Activated:Connect(function()
        tab:Activate()
    end)

    tab.Button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(tab.Button, 0.12, {
                BackgroundTransparency = 0,
                BackgroundColor3 = COLORS.Hover,
            })
        end
    end)

    tab.Button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(tab.Button, 0.12, {
                BackgroundTransparency = 1,
            })
        end
    end)

    function tab:CreateSection(title)
        local section = create("Frame", {
            Name = title,
            Size = UDim2.new(1, 0, 0, 34),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = COLORS.Surface,
            BorderSizePixel = 0,
        }, self.Page)

        corner(section, 8)
        stroke(section)

        label(section, title, 12,
            UDim2.fromOffset(12, 5),
            UDim2.new(1, -24, 0, 24)
        ).Font = Enum.Font.GothamBold

        local elements = create("Frame", {
            Position = UDim2.fromOffset(8, 34),
            Size = UDim2.new(1, -16, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
        }, section)

        create("UIListLayout", {
            Padding = UDim.new(0, 7),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, elements)

        create("UIPadding", {
            PaddingBottom = UDim.new(0, 9),
        }, elements)

        local api = {}

        local function makeButton(text, callback, isToggle)
            local button = create("TextButton", {
                Name = text,
                Text = text,
                TextSize = 13,
                Font = Enum.Font.Gotham,
                TextColor3 = COLORS.Text,
                BackgroundColor3 = COLORS.Hover,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 34),
                AutoButtonColor = false,
            }, elements)

            corner(button, 6)

            button.MouseEnter:Connect(function()
                tween(button, 0.12, {
                    BackgroundColor3 = COLORS.Border
                })
            end)

            button.MouseLeave:Connect(function()
                tween(button, 0.12, {
                    BackgroundColor3 = COLORS.Hover
                })
            end)

            if isToggle then
                local enabled = false

                local function update()
                    button.Text = text .. (enabled and "    ON" or "    OFF")
                    button.TextColor3 = enabled and self.Library.Accent
                        or COLORS.Text
                end

                update()

                button.Activated:Connect(function()
                    enabled = not enabled
                    update()
                    if callback then
                        callback(enabled)
                    end
                end)

                return {
                    Set = function(_, value)
                        enabled = value == true
                        update()
                    end,
                    Get = function()
                        return enabled
                    end,
                }
            else
                button.Activated:Connect(function()
                    if callback then
                        callback()
                    end
                end)
            end

            return button
        end

        function api:CreateButton(text, callback)
            return makeButton(text, callback, false)
        end

        function api:CreateToggle(text, callback)
            return makeButton(text, callback, true)
        end

        function api:CreateSlider(text, minimum, maximum, callback)
            minimum = minimum or 0
            maximum = maximum or 100

            assert(maximum > minimum, "Maximum must exceed minimum")

            local holder = create("Frame", {
                Name = text,
                Size = UDim2.new(1, 0, 0, 54),
                BackgroundColor3 = COLORS.Hover,
                BorderSizePixel = 0,
            }, elements)

            corner(holder, 6)

            local value = minimum
            local title = label(holder, text, 12,
                UDim2.fromOffset(10, 3),
                UDim2.new(1, -20, 0, 22)
            )

            local bar = create("Frame", {
                Position = UDim2.new(0, 10, 0, 33),
                Size = UDim2.new(1, -20, 0, 6),
                BackgroundColor3 = COLORS.Border,
                BorderSizePixel = 0,
            }, holder)

            corner(bar, 4)

            local fill = create("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = self.Library.Accent,
                BorderSizePixel = 0,
            }, bar)

            corner(fill, 4)

            local function setValue(newValue)
                value = math.clamp(newValue, minimum, maximum)
                local percent = (value - minimum) / (maximum - minimum)

                fill.Size = UDim2.new(percent, 0, 1, 0)
                title.Text = text .. ": " .. tostring(
                    math.floor(value * 100 + 0.5) / 100
                )

                if callback then
                    callback(value)
                end
            end

            local function updateFromX(x)
                local percent = math.clamp(
                    (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                    0, 1
                )
                setValue(minimum + (maximum - minimum) * percent)
            end

            local sliding = false

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateFromX(input.Position.X)
                end
            end)

            local moveConnection = UserInputService.InputChanged:Connect(
                function(input)
                    if sliding and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        updateFromX(input.Position.X)
                    end
                end
            )

            local endConnection = UserInputService.InputEnded:Connect(
                function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end
            )

            table.insert(self.Library.Connections, moveConnection)
            table.insert(self.Library.Connections, endConnection)

            setValue(minimum)

            return {
                Set = function(_, newValue)
                    setValue(newValue)
                end,
                Get = function()
                    return value
                end,
            }
        end

        function api:CreateDropdown(text, options, callback)
            options = options or {}

            local selected = nil
            local opened = false

            local container = create("Frame", {
                Name = text,
                Size = UDim2.new(1, 0, 0, 36),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
            }, elements)

            local main = create("TextButton", {
                Text = text .. "    ▼",
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextColor3 = COLORS.Text,
                BackgroundColor3 = COLORS.Hover,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 36),
                AutoButtonColor = false,
            }, container)

            corner(main, 6)

            local list = create("Frame", {
                Position = UDim2.fromOffset(0, 40),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = COLORS.Surface,
                BorderSizePixel = 0,
                Visible = false,
            }, container)

            corner(list, 6)
            stroke(list)

            create("UIListLayout", {
                Padding = UDim.new(0, 3),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, list)

            local function refresh()
                for _, child in ipairs(list:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end

                for _, option in ipairs(options) do
                    local choice = create("TextButton", {
                        Text = tostring(option),
                        TextSize = 12,
                        Font = Enum.Font.Gotham,
                        TextColor3 = COLORS.Text,
                        BackgroundColor3 = COLORS.Surface,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, 30),
                    }, list)

                    choice.Activated:Connect(function()
                        selected = option
                        main.Text = text .. ": " .. tostring(option) .. "    ▼"
                        opened = false
                        list.Visible = false

                        if callback then
                            callback(option)
                        end
                    end)
                end
            end

            main.Activated:Connect(function()
                opened = not opened
                list.Visible = opened
            end)

            refresh()

            return {
                SetOptions = function(_, newOptions)
                    options = newOptions or {}
                    refresh()
                end,
                Get = function()
                    return selected
                end,
            }
        end

        return api
    end

    table.insert(self.Tabs, tab)

    if #self.Tabs == 1 then
        tab:Activate()
    end

    return tab
end

function ClassicUI:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    for _, connection in ipairs(self.Connections) do
        connection:Disconnect()
    end

    table.clear(self.Connections)

    if self.Screen then
        self.Screen:Destroy()
    end
end

return ClassicUI
