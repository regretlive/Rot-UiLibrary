		BackgroundTransparency = 1,
		Text = cfg.Text or "Toggle",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local pill = new("TextButton", {
		Size = UDim2.fromOffset(40, 20),
		Position = UDim2.new(1, -52, 0.5, -10),
		BackgroundColor3 = state and Theme.Good or Theme.Stroke,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	})
	pill.Parent = row
	corner(pill, M.RadiusPill)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
	})
	knob.Parent = pill
	corner(knob, 8)

	local function apply(v)
		state = v
		tween(pill, { BackgroundColor3 = state and Theme.Good or Theme.Stroke }, 0.16)
		tween(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.18)
		if cfg.Callback then
			local ok, err = pcall(cfg.Callback, state)
			if not ok then warn("[RotUI] toggle callback: " .. tostring(err)) end
		end
	end

	track(pill.MouseButton1Click:Connect(function() apply(not state) end))
	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end

	if cfg.Default ~= nil then apply(cfg.Default) end

	return {
		Set = apply,
		Get = function() return state end,
		Instance = row,
	}
end

-- ------------------------------------------------------------
-- Slider
-- ------------------------------------------------------------
function RotUI:Slider(parent, cfg)
	cfg = cfg or {}
	local host = containerFrame(parent)
	local min = cfg.Min or 0
	local max = cfg.Max or 100
	local val = cfg.Default or min
	local decimals = cfg.Decimals or 2
	local suffix = cfg.Suffix or ""

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, M.RowTall + 4),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
		LayoutOrder = cfg.Order or nextOrder(host),
	})
	row.Parent = host
	corner(row, M.RadiusSm)
	stroke(row, Theme.Stroke, 1)

	new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1,
		Text = cfg.Text or "Slider",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valLabel = new("TextLabel", {
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1,
		Text = string.format("%."..decimals.."f%s", val, suffix),
		TextColor3 = Theme.TextDim,
		Font = Theme.FontMono,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local track = new("Frame", {
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.new(0, 12, 1, -16),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
	})
	track.Parent = row
	corner(track, 3)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	})
	fill.Parent = track
	corner(fill, 3)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		ZIndex = 3,
	})
	knob.Parent = track
	corner(knob, 7)

	local function apply(v, silent)
		v = math.clamp(v, min, max)
		val = v
		local alpha = (max - min) == 0 and 0 or (v - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valLabel.Text = string.format("%."..decimals.."f%s", v, suffix)
		if not silent and cfg.Callback then
			local ok, err = pcall(cfg.Callback, val)
			if not ok then warn("[RotUI] slider callback: " .. tostring(err)) end
		end
	end

	local dragging = false
	local function update(input)
		local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		apply(min + math.clamp(rel, 0, 1) * (max - min))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			update(input)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end
	apply(val, true)

	return {
		Set = apply,
		Get = function() return val end,
		Instance = row,
	}
end

