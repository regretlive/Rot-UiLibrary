		Name = "FloatingOrb",
		Size = UDim2.fromOffset(M.Orb, M.Orb),
		Position = UDim2.new(0, 24, 0.5, -M.Orb / 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Text = "R",
		TextColor3 = Theme.Text,
		Font = Theme.FontBlack,
		TextSize = 22,
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 150,
	})
	orb.Parent = self.gui
	corner(orb, M.Orb / 2)
	local orbGlow = stroke(orb, Theme.AccentSoft, 2)
	orbGlow.Transparency = 0.35

	self.orb = orb

	do
		local dragging, dragStart, startPos, moved
		track(orb.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				dragging, moved = true, false
				dragStart = input.Position
				startPos = orb.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						if not moved then self:ToggleShortcuts() end
					end
				end)
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - dragStart
				if delta.Magnitude > 4 then moved = true end
				orb.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
	end

	-- ============================================================
	-- shortcut rail
	-- ============================================================
	local rail = new("Frame", {
		Name = "ShortcutRail",
		Size = UDim2.fromOffset(scale(M.RailW), 0),
		Position = UDim2.new(0, M.Orb + 36, 0.5, -60),
		BackgroundColor3 = Theme.BgElev,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 149,
	})
	rail.Parent = self.gui
	corner(rail, M.Radius)
	stroke(rail, Theme.Stroke, 1)

	local railList = new("ScrollingFrame", {
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	})
	railList.Parent = rail
	list(railList, 6)
	self._rail = rail
	self._railList = railList
	self._shortcutOpen = false

	-- ============================================================
	-- notifications
	-- ============================================================
	self.Notify = Notify.new(self.gui)

	-- ============================================================
	-- config store
	-- ============================================================
	self._config = {}

	-- ============================================================
	-- first paint — warm the window in
	-- ============================================================
	win.BackgroundTransparency = 0.2
	tween(win, { BackgroundTransparency = 0 }, 0.25)

	return self
end

-- ============================================================
-- core methods
-- ============================================================
function RotUI:ToggleLock()
	self._locked = not self._locked
	local grip = self.window:FindFirstChild("ResizeGrip")
	if grip then grip.Visible = not self._locked end
	tween(self._lockBtn, {
		BackgroundColor3 = self._locked and Theme.Good or Theme.Bg,
		TextColor3 = self._locked and Theme.Text or Theme.TextDim,
	}, 0.15)
	self:Notify:Push({
		Type = "info",
		Title = self._locked and "Window locked" or "Window unlocked",
		Text = self._locked and "Position pinned, resize disabled." or "Drag and resize enabled.",
		Duration = 2.5,
	})
end

function RotUI:Minimize()
	self._minimized = not self._minimized
	local target
	if self._minimized then
		self._restoreSize = self.window.Size
		target = UDim2.fromOffset(M.Orb, M.Orb)
	else
		target = self._restoreSize or UDim2.fromOffset(M.WindowW, M.WindowH)
	end
	tween(self.window, { Size = target }, 0.25, Enum.EasingStyle.Quart)
	self.orb.Visible = self._minimized
end

function RotUI:SetVisible(v)
	self._visible = v
	self.window.Visible = v
	self.orb.Visible = (not v) or self._minimized
end

function RotUI:Destroy()
	if self._destroyed then return end
	self._destroyed = true
	disconnectAll()
	pcall(function() self.gui:Destroy() end)
end

-- ============================================================
-- tab creation
-- ============================================================
function RotUI:Tab(name, icon)
	local self_ = self

	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	})
	btn.Parent = self._tabHolder
	corner(btn, M.RadiusSm)

	local indicator = new("Frame", {
		Size = UDim2.new(0, 3, 0.6, 0),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 4,
	})
	indicator.Parent = btn
	corner(indicator, 2)

	new("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(24, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = Theme.TextDim,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = btn,
	})

	local page = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 2,
	})
	page.Parent = self._content
	list(page, 8, Enum.FillDirection.Vertical, Enum.SortOrder.LayoutOrder)
	pad(page, 2, 6)

	local tab = {
		_btn = btn,
		_page = page,
		_name = name,
		_index = #self._tabs + 1,
		_components = {},
	}

	function tab:Select()
		for _, t in ipairs(self_._tabs) do
			t._page.Visible = false
			t._btn.BackgroundTransparency = 0.35
			t._btn:FindFirstChildOfClass("Frame").Visible = false
			local lbl = t._btn:FindFirstChildOfClass("TextLabel")
			if lbl then tween(lbl, { TextColor3 = Theme.TextDim }, 0.12) end
		end
		page.Visible = true
		tween(btn, { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0 }, 0.15)
		indicator.Visible = true
		local lbl = btn:FindFirstChildOfClass("TextLabel")
		if lbl then tween(lbl, { TextColor3 = Theme.Text }, 0.12) end
		self_._activeTab = tab
	end

	track(btn.MouseButton1Click:Connect(function() tab:Select() end))

	table.insert(self._tabs, tab)
	if #self._tabs == 1 then tab:Select() end

	-- ============================================================
	-- section grouping inside tab
	-- ============================================================
	function tab:Section(title)
		local wrap = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.BgElev,
			BorderSizePixel = 0,
			LayoutOrder = #self._components + 1,
		})
		wrap.Parent = page
		corner(wrap, M.Radius)
		stroke(wrap, Theme.StrokeSoft, 1)
		pad(wrap, M.Pad)
		list(wrap, M.Gap)

		if title and title ~= "" then
			local head = new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = title,
				TextColor3 = Theme.Text,
				Font = Theme.FontBold,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = -100,
				Parent = wrap,
			})
		end

		local sec = { _frame = wrap, _tab = tab }
		function sec:Divider()
			return self._tab:Divider(wrap)
		end
		table.insert(self._components, wrap)
		return sec
	end

	return tab
end

-- ============================================================
-- components — each takes (parent, cfg)
--   parent can be a Section or a Tab
-- ============================================================
local function containerFrame(parent)
	if parent and parent._frame then return parent._frame end
	if parent and parent._page then return parent._page end
	return parent
end

local function nextOrder(host)
	local c = 0
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("GuiObject") and ch.LayoutOrder then
			c = math.max(c, ch.LayoutOrder)
		end
	end
	return c + 1
end

