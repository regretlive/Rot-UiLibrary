            Name = "Page_" .. name,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 4,
            Visible = false,
            Parent = scroll,
        })
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 7),
            Parent = page,
        })

        local tabApi = {}
        tabApi.Page = page
        tabApi.Button = btn

        function tabApi:Select()
            for _, t in ipairs(tabs) do
                t.Button.BackgroundColor3 = Palette.Panel2
                t.Button.BackgroundTransparency = 1
                t.Button.TextColor3 = Palette.TextDim
                t.Button.AccentBar.Visible = false
                t.Page.Visible = false
            end
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = Palette.Panel2
            btn.TextColor3 = Palette.Text
            btnAccent.Visible = true
            page.Visible = true
            currentTab = tabApi
        end

        function tabApi:AddSection(text)
            local section = new("Frame", {
                Name = "Section",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
                ZIndex = 5,
                Parent = page,
            })
            local lbl = new("TextLabel", {
                Name = "SectionLabel",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 2, 0, 0),
                Size = UDim2.new(1, -4, 0, 18),
                Font = Enum.Font.GothamBold,
                Text = string.upper(text or "SECTION"),
                TextColor3 = Palette.TextFaint,
                TextSize = 10,
