		Size = UDim2.new(1, -12, 0, 14),
		Position = UDim2.new(0, 6, 0, 122),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	})
	hueRow.Parent = body
	corner(hueRow, 4)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hueRow,
	})

	local hueDot = new("Frame", {
		Size = UDim2.fromOffset(10, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(h, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
	})
	hueDot.Parent = hueRow
	corner(hueDot, 5)
	stroke(hueDot, Color3.new(0, 0, 0), 1.5)

	-- hex box
	local hexWrap = new("Frame", {
		Size = UDim2.new(1, -12, 0, 24),
		Position = UDim2.new(0, 6, 0, 142),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
	})
	hexWrap.Parent = body
	corner(hexWrap, 6)

	local hexBox = new("TextBox", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Text = rgbToHex(color),
		TextColor3 = Theme.Text,
		Font = Theme.FontMono,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
	})
	hexBox.Parent = hexWrap

	local open = false
	local function apply(c, silent)
		color = c
		swatch.BackgroundColor3 = c
		h, s, v = rgbToHsv(c)
		svWrap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svDot.Position = UDim2.fromScale(s, 1 - v)
		hueDot.Position = UDim2.new(h, 0, 0.5, 0)
		if not silent then hexBox.Text = rgbToHex(c) end
		if cfg.Callback then pcall(cfg.Callback, c) end
	end

	local function setOpen(v)
		open = v
		if open then
			body.Visible = true
			tween(body, { Size = UDim2.new(1, 0, 0, 172) }, 0.18)
		else
			tween(body, { Size = UDim2.new(1, 0, 0, 0) }, 0.16)
			task.delay(0.16, function() if not open then body.Visible = false end end)
		end
	end

	track(row.MouseButton1Click:Connect(function() setOpen(not open) end))

	local svDrag = false
	local function updateSV(input)
		local relX = math.clamp((input.Position.X - svWrap.AbsolutePosition.X) / math.max(1, svWrap.AbsoluteSize.X), 0, 1)
		local relY = math.clamp((input.Position.Y - svWrap.AbsolutePosition.Y) / math.max(1, svWrap.AbsoluteSize.Y), 0, 1)
		s = relX
		v = 1 - relY
		apply(Color3.fromHSV(h, s, v), true)
		hexBox.Text = rgbToHex(color)
	end
	track(svWrap.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			svDrag = true
			updateSV(input)
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not svDrag then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			updateSV(input)
		end
	end))
	track(UserInputService.InputEnded:Connect(function()
		svDrag = false
	end))

	local hueDrag = false
	local function updateHue(input)
		local relX = math.clamp((input.Position.X - hueRow.AbsolutePosition.X) / math.max(1, hueRow.AbsoluteSize.X), 0, 1)
		h = relX
		apply(Color3.fromHSV(h, s, v), true)
		hexBox.Text = rgbToHex(color)
	end
	track(hueRow.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			hueDrag = true
			updateHue(input)
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not hueDrag then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			updateHue(input)
		end
	end))
	track(UserInputService.InputEnded:Connect(function()
		hueDrag = false
	end))

	track(hexBox.FocusLost:Connect(function()
		local c = hexToRgb(hexBox.Text)
		apply(c, true)
		hexBox.Text = rgbToHex(c)
	end))

	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end

	return {
		Set = apply,
		Get = function() return color end,
		Instance = wrap,
	}
end

