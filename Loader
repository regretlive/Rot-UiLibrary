-- Dropdown (single + multi select)
-- ------------------------------------------------------------
function RotUI:Dropdown(parent, cfg)
	cfg = cfg or {}
	local host = containerFrame(parent)
	local multi = cfg.Multi or false
	local options = cfg.Options or {}
	local searchable = cfg.Searchable ~= false

	local selected
	if multi then
		selected = {}
		for _, v in ipairs(cfg.Default or {}) do selected[v] = true end
	else
		selected = cfg.Default or (options[1] or nil)
	end

	local wrap = new("Frame", {
		Size = UDim2.new(1, 0, 0, M.Row),
		BackgroundTransparency = 1,
		LayoutOrder = cfg.Order or nextOrder(host),
	})
	wrap.Parent = host
	list(wrap, 4)

	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, M.Row),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	})
	row.Parent = wrap
	corner(row, M.RadiusSm)
	stroke(row, Theme.Stroke, 1)

	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -44, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text = cfg.Text or "Dropdown",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLbl = new("TextLabel", {
		Size = UDim2.new(1, -44, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Theme.TextDim,
		Font = Theme.Font,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local chev = new("TextLabel", {
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, -26, 0.5, -10),
		BackgroundTransparency = 1,
		Text = "▾",
		TextColor3 = Theme.TextDim,
		Font = Theme.FontBold,
		TextSize = 12,
		Parent = row,
	})

	local body = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.BgElev,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
	})
	body.Parent = wrap
	corner(body, M.RadiusSm)
	stroke(body, Theme.StrokeSoft, 1)

	local searchWrap = new("Frame", {
		Size = UDim2.new(1, -12, 0, 24),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Theme.BgInput,
		BorderSizePixel = 0,
		Visible = searchable,
	})
	searchWrap.Parent = body
	corner(searchWrap, 6)

	local searchBox = new("TextBox", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search",
		PlaceholderColor3 = Theme.TextMute,
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
	})
	searchBox.Parent = searchWrap

	local optionHolder = new("ScrollingFrame", {
		Size = UDim2.new(1, -12, 0, 0),
		Position = UDim2.fromOffset(6, searchable and 34 or 6),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	})
	optionHolder.Parent = body
	list(optionHolder, 2)

	local open = false
	local maxShownRows = cfg.MaxRows or 6

	local function renderValue()
		if multi then
			local names = {}
			for _, opt in ipairs(options) do
				if selected[opt] then table.insert(names, tostring(opt)) end
			end
			if #names == 0 then valueLbl.Text = "none" else valueLbl.Text = table.concat(names, ", ") end
		else
			valueLbl.Text = selected and tostring(selected) or "none"
		end
	end

	local optionButtons = {}
	local function rebuildOptions(filter)
		for _, c in ipairs(optionHolder:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		optionButtons = {}
		filter = (filter or ""):lower()

		for i, opt in ipairs(options) do
			if filter == "" or tostring(opt):lower():find(filter, 1, true) then
				local isSel
				if multi then isSel = selected[opt] == true
				else isSel = selected == opt end

				local ob = new("TextButton", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = isSel and Theme.AccentDim or Theme.Bg,
					BackgroundTransparency = isSel and 0.1 or 0.5,
					BorderSizePixel = 0,
					Text = tostring(opt),
					TextColor3 = isSel and Theme.Text or Theme.TextDim,
					Font = Theme.Font,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					LayoutOrder = i,
				})
				ob.Parent = optionHolder
				corner(ob, 6)
				pad(ob, 0, 10)

				track(ob.MouseEnter:Connect(function()
					if not isSel then tween(ob, { BackgroundTransparency = 0.2 }, 0.1) end
				end))
				track(ob.MouseLeave:Connect(function()
					if not isSel then tween(ob, { BackgroundTransparency = 0.5 }, 0.1) end
				end))

				track(ob.MouseButton1Click:Connect(function()
					if multi then
						selected[opt] = not selected[opt]
					else
						selected = opt
						self:CloseDropdown()
					end
					renderValue()
					rebuildOptions(searchBox.Text)
					if cfg.Callback then
						if multi then
							local arr = {}
							for _, v in ipairs(options) do if selected[v] then table.insert(arr, v) end end
							pcall(cfg.Callback, arr)
						else
							pcall(cfg.Callback, selected)
						end
					end
				end))

				table.insert(optionButtons, ob)
			end
		end
	end

	local function setOpen(v)
		open = v
		if open then
			body.Visible = true
			local rows = math.min(maxShownRows, math.max(1, #optionButtons))
			local bodyH = (searchable and 34 or 6) + 6 + rows * 28
			tween(body, { Size = UDim2.new(1, 0, 0, bodyH) }, 0.18)
			tween(chev, { Rotation = 180 }, 0.18)
		else
			tween(body, { Size = UDim2.new(1, 0, 0, 0) }, 0.16)
			tween(chev, { Rotation = 0 }, 0.16)
			task.delay(0.16, function()
				if not open then body.Visible = false end
			end)
		end
	end

	self._openDropdowns = self._openDropdowns or {}
	function self:CloseDropdown()
		for _, fn in ipairs(self._openDropdowns) do fn(false) end
	end
	table.insert(self._openDropdowns, setOpen)

	track(row.MouseButton1Click:Connect(function()
		self:CloseDropdown()
		setOpen(not open)
	end))

	track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		rebuildOptions(searchBox.Text)
	end))

	if cfg.Tooltip then attachTooltip(row, cfg.Tooltip) end

	renderValue()
	rebuildOptions("")

	return {
		Set = function(v)
			if multi then
				selected = {}
				for _, x in ipairs(v) do selected[x] = true end
			else
				selected = v
			end
			renderValue()
			rebuildOptions(searchBox.Text)
		end,
		Get = function()
			if multi then
				local arr = {}
				for _, v in ipairs(options) do if selected[v] then table.insert(arr, v) end end
				return arr
			end
			return selected
		end,
		SetOptions = function(newOptions)
			options = newOptions
			rebuildOptions(searchBox.Text)
		end,
		Instance = wrap,
	}
end

