
local Rot = {}
Rot.__index = Rot

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer

local Theme = {
    Background = Color3.fromRGB(12, 13, 20),
    Surface = Color3.fromRGB(19, 21, 32),
    Surface2 = Color3.fromRGB(27, 29, 44),
    Accent = Color3.fromRGB(116, 85, 255),
    Accent2 = Color3.fromRGB(69, 145, 255),
    Text = Color3.fromRGB(242, 243, 255),
    Muted = Color3.fromRGB(151, 157, 180),
    Border = Color3.fromRGB(42, 45, 65),
    Green = Color3.fromRGB(70, 220, 155)
}

local function Create(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, parent)
end

local function Stroke(parent, color, transparency)
    return Create("UIStroke", {
        Color = color or Theme.Border,
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function Tween(obj, duration, props)
    local animation = TweenService:Create(
        obj,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )

    animation:Play()
    return animation
end

function Rot:CreateWindow(config)
    config = config or {}

    local Window = {}
    local Connections = {}
    local Tabs = {}
    local SelectedTab
    local Destroyed = false

    local Title = config.Title or "Rot UI"
    local Subtitle = config.Subtitle or "Modern UI Library"
    local LoadingTitle = config.LoadingTitle or "Rot UI"

    local Parent

    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and result then
            Parent = result
        end
    end

    if not Parent then
        Parent = Player:WaitForChild("PlayerGui")
    end

    for _, gui in ipairs(Parent:GetChildren()) do
        if gui.Name == "RotUI" or gui.Name == "RotLoading" then
            gui:Destroy()
        end
    end

    local LoadingGui = Create("ScreenGui", {
        Name = "RotLoading",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Parent)

    local LoadingBackground = Create("Frame", {
        Name = "Background",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    }, LoadingGui)

    local Glow = Create("Frame", {
        Size = UDim2.fromOffset(240, 240),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.43),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.91,
        BorderSizePixel = 0
    }, LoadingBackground)
    Corner(Glow, 120)

    local LoadingCard = Create("Frame", {
        Name = "LoadingCard",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(330, 205),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, LoadingBackground)

    Create("UISizeConstraint", {
        MinSize = Vector2.new(260, 205),
        MaxSize = Vector2.new(380, 205)
    }, LoadingCard)

    LoadingCard.Size = UDim2.new(0.86, 0, 0, 205)
    Corner(LoadingCard, 16)
    Stroke(LoadingCard)

    local Logo = Create("TextLabel", {
        Position = UDim2.new(0, 0, 0, 14),
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundTransparency = 1,
        Text = "R",
        TextColor3 = Theme.Accent,
        TextSize = 42,
        Font = Enum.Font.GothamBlack
    }, LoadingCard)

    local LoadingName = Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 61),
        Size = UDim2.new(1, -20, 0, 28),
        BackgroundTransparency = 1,
        Text = LoadingTitle,
        TextColor3 = Theme.Text,
        TextSize = 20,
        Font = Enum.Font.GothamBold,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, LoadingCard)

    local LoadingSubtitle = Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 89),
        Size = UDim2.new(1, -20, 0, 20),
        BackgroundTransparency = 1,
        Text = "Initializing your experience",
        TextColor3 = Theme.Muted,
        TextSize = 11,
        Font = Enum.Font.Gotham
    }, LoadingCard)

    local ProgressBack = Create("Frame", {
        Position = UDim2.new(0, 20, 0, 132),
        Size = UDim2.new(1, -40, 0, 5),
        BackgroundColor3 = Theme.Surface2,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, LoadingCard)
    Corner(ProgressBack, 6)

    local Progress = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, ProgressBack)
    Corner(Progress, 6)

    local Status = Create("TextLabel", {
        Position = UDim2.new(0, 20, 0, 145),
        Size = UDim2.new(1, -40, 0, 20),
        BackgroundTransparency = 1,
        Text = "Preparing interface...",
        TextColor3 = Theme.Muted,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, LoadingCard)

    local Percent = Create("TextLabel", {
        Position = UDim2.new(1, -65, 0, 145),
        Size = UDim2.fromOffset(45, 20),
        BackgroundTransparency = 1,
        Text = "0%",
        TextColor3 = Theme.Text,
        TextSize = 10,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Right
    }, LoadingCard)

    local Gui = Create("ScreenGui", {
        Name = "RotUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Parent)

    local Main = Create("Frame", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.53),
        Size = config.Size or UDim2.new(0.9, 0, 0.72, 0),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true
    }, Gui)

    Create("UISizeConstraint", {
        MinSize = Vector2.new(280, 250),
        MaxSize = Vector2.new(760, 580)
    }, Main)

    Corner(Main, 14)
    Stroke(Main)

    local Topbar = Create("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, Main)

    local Brand = Create("TextLabel", {
        Position = UDim2.fromOffset(14, 7),
        Size = UDim2.fromOffset(35, 38),
        BackgroundTransparency = 1,
        Text = "R",
        TextColor3 = Theme.Accent,
        TextSize = 30,
        Font = Enum.Font.GothamBlack
    }, Topbar)

    local TitleLabel = Create("TextLabel", {
        Position = UDim2.fromOffset(49, 7),
        Size = UDim2.new(1, -125, 0, 22),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Theme.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, Topbar)

    local SubtitleLabel = Create("TextLabel", {
        Position = UDim2.fromOffset(50, 29),
        Size = UDim2.new(1, -130, 0, 16),
        BackgroundTransparency = 1,
        Text = Subtitle,
        TextColor3 = Theme.Muted,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, Topbar)

    local Close = Create("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = Theme.Surface2,
        Text = "×",
        TextColor3 = Theme.Muted,
        TextSize = 20,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false
    }, Topbar)
    Corner(Close, 8)

    local TabBar = Create("ScrollingFrame", {
        Name = "TabBar",
        Position = UDim2.fromOffset(10, 62),
        Size = UDim2.new(1, -20, 0, 37),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        CanvasSize = UDim2.new()
    }, Main)

    local TabLayout = Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, TabBar)

    local Content = Create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(10, 108),
        Size = UDim2.new(1, -20, 1, -118),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    }, Main)

    local function SelectTab(tab)
        SelectedTab = tab

        for _, item in ipairs(Tabs) do
            item.Page.Visible = item == tab

            Tween(item.Button, 0.18, {
                BackgroundColor3 = item == tab
                    and Theme.Accent
                    or Theme.Surface
            })

            item.Button.TextColor3 = item == tab
                and Color3.new(1, 1, 1)
                or Theme.Muted
        end
    end

    function Window:AddTab(name)
        local Tab = {}
        local index = #Tabs + 1

        local Button = Create("TextButton", {
            Name = "Tab_" .. index,
            Size = UDim2.fromOffset(105, 33),
            BackgroundColor3 = Theme.Surface,
            Text = tostring(name or "Tab"),
            TextColor3 = Theme.Muted,
            TextSize = 12,
            Font = Enum.Font.GothamSemibold,
            AutoButtonColor = false,
            LayoutOrder = index
        }, TabBar)
        Corner(Button, 8)

        local Page = Create("ScrollingFrame", {
            Name = "Page_" .. index,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(),
            Visible = false
        }, Content)

        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, Page)

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 2),
            PaddingRight = UDim.new(0, 2)
        }, Page)

        Tab.Button = Button
        Tab.Page = Page

        function Tab:AddLabel(text)
            local LabelFrame = Create("Frame", {
                Name = "Label",
                Size = UDim2.new(1, -4, 0, 42),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.Y,
                ClipsDescendants = true
            }, Page)
            Corner(LabelFrame, 9)
            Stroke(LabelFrame, Theme.Border, 0.2)

            Create("Frame", {
                Position = UDim2.new(0, 0, 0, 8),
                Size = UDim2.new(0, 3, 1, -16),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0
            }, LabelFrame)

            local TextLabel = Create("TextLabel", {
                Name = "Text",
                Position = UDim2.fromOffset(13, 0),
                Size = UDim2.new(1, -25, 0, 42),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.Y,
                Text = tostring(text or ""),
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center
            }, LabelFrame)

            Create("UIPadding", {
                PaddingTop = UDim.new(0, 11),
                PaddingBottom = UDim.new(0, 11)
            }, TextLabel)

            local LabelObject = {}

            function LabelObject:SetText(newText)
                TextLabel.Text = tostring(newText)
            end

            function LabelObject:SetVisible(visible)
                LabelFrame.Visible = visible
            end

            function LabelObject:Destroy()
                LabelFrame:Destroy()
            end

            LabelObject.Instance = LabelFrame
            return LabelObject
        end

        Button.Activated:Connect(function()
            SelectTab(Tab)
        end)

        table.insert(Tabs, Tab)

        if not SelectedTab then
            SelectTab(Tab)
        end

        return Tab
    end

    function Window:SetTitle(text)
        TitleLabel.Text = tostring(text)
    end

    function Window:SetSubtitle(text)
        SubtitleLabel.Text = tostring(text)
    end

    function Window:Destroy()
        if Destroyed then
            return
        end

        Destroyed = true

        for _, connection in ipairs(Connections) do
            connection:Disconnect()
        end

        Gui:Destroy()
        LoadingGui:Destroy()
    end

    local dragging = false
    local dragStart
    local startPosition
    local dragInput

    table.insert(Connections, Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    table.insert(Connections, Topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(Connections, UIS.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end))

    table.insert(Connections, Close.Activated:Connect(function()
        Window:Destroy()
    end))

    table.insert(Connections, Close.MouseEnter:Connect(function()
        Tween(Close, 0.15, {
            BackgroundColor3 = Color3.fromRGB(190, 60, 80)
        })
    end))

    table.insert(Connections, Close.MouseLeave:Connect(function()
        Tween(Close, 0.15, {
            BackgroundColor3 = Theme.Surface2
        })
    end))

    task.spawn(function()
        local stages = {
            {0.22, "Preparing interface..."},
            {0.48, "Building components..."},
            {0.72, "Loading library..."},
            {0.90, "Applying theme..."},
            {1, "Ready!"}
        }

        for _, stage in ipairs(stages) do
            if Destroyed or not LoadingGui.Parent then
                return
            end

            Status.Text = stage[2]
            Percent.Text = math.floor(stage[1] * 100) .. "%"

            Tween(Progress, 0.35, {
                Size = UDim2.new(stage[1], 0, 1, 0)
            })

            task.wait(0.38)
        end

        if Destroyed then
            return
        end

        task.wait(0.25)

        if not Gui.Parent then
            return
        end

        Main.Visible = true
        Main.BackgroundTransparency = 1
        Main.Position = UDim2.fromScale(0.5, 0.54)

        Tween(Main, 0.35, {
            BackgroundTransparency = 0,
            Position = UDim2.fromScale(0.5, 0.5)
        })

        Tween(LoadingBackground, 0.25, {
            BackgroundTransparency = 1
        })

        task.wait(0.28)

        if LoadingGui.Parent then
            LoadingGui:Destroy()
        end
    end)

    Window.Gui = Gui
    Window.Main = Main
    Window.Content = Content
    Window.TabBar = TabBar

    return Window
end

return setmetatable({}, Rot)
