    local scroll = new("ScrollingFrame", {
        Name = "Scroll",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Palette.Panel3,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = content,
    })

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 7),
        Parent = scroll,
    })

    local grip = new("TextButton", {
        Name = "ResizeGrip",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.fromOffset(16, 16),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 8,
        Parent = win,
    })
    for i = 1, 3 do
        new("Frame", {
            BackgroundColor3 = Palette.TextFaint,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -(i - 1) * 3 - 2, 1, -2),
            Size = UDim2.fromOffset(3, 3),
            ZIndex = 9,
            Parent = grip,
        })
    end

    local state = {
        Minimized   = false,
        Fullscreen  = false,
        Visible     = false,
        UserSize    = size,
        UserPos     = win.Position,
        RestoreSize = size,
        RestorePos  = win.Position,
    }

    local function applySize(sz, pos)
        win.Size = sz
        shadow.Size = sz
        if pos then
            win.Position = pos
            shadow.Position = UDim2.new(pos.X.Scale, pos.X.Offset + 5, pos.Y.Scale, pos.Y.Offset + 5)
        end
        state.UserSize = sz
        state.UserPos = win.Position
    end

    trackConn(connBag, minBtn.MouseButton1Click:Connect(function()
        state.Minimized = not state.Minimized
        body.Visible = not state.Minimized
        local target = state.Minimized
            and UDim2.fromOffset(win.AbsoluteSize.X, 32)
            or state.UserSize
        tween(win, 0.16, { Size = target })
        tween(shadow, 0.16, { Size = target })
    end))

    trackConn(connBag, maxBtn.MouseButton1Click:Connect(function()
        state.Fullscreen = not state.Fullscreen
        if state.Fullscreen then
            state.RestoreSize = win.Size
            state.RestorePos  = win.Position
            local cam = workspace.CurrentCamera
            local vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
            local fw = math.floor(vp.X * 0.9)
            local fh = math.floor(vp.Y * 0.9)
            tween(win, 0.2, {
                Size = UDim2.fromOffset(fw, fh),
                Position = UDim2.new(0.5, -fw / 2, 0.5, -fh / 2),
            })
            tween(shadow, 0.2, {
                Size = UDim2.fromOffset(fw, fh),
                Position = UDim2.new(0.5, -fw / 2 + 5, 0.5, -fh / 2 + 5),
            })
            maxBtn.Text = "❐"
        else
            tween(win, 0.2, { Size = state.RestoreSize, Position = state.RestorePos })
            tween(shadow, 0.2, {
                Size = state.RestoreSize,
                Position = UDim2.new(
                    state.RestorePos.X.Scale, state.RestorePos.X.Offset + 5,
                    state.RestorePos.Y.Scale, state.RestorePos.Y.Offset + 5
                ),
            })
            maxBtn.Text = "□"
        end
    end))

    local function setVisible(v)
        if state.Visible == v then return end
        state.Visible = v
        if v then
            win.Visible = true
            win.Size = UDim2.fromOffset(win.AbsoluteSize.X, 0)
            tween(win, 0.18, { Size = state.UserSize })
            tween(shadow, 0.18, { Size = state.UserSize })
        else
            tween(win, 0.14, { Size = UDim2.fromOffset(win.AbsoluteSize.X, 0) })
            tween(shadow, 0.14, { Size = UDim2.fromOffset(win.AbsoluteSize.X, 0) })
            task.delay(0.15, function()
                if gui and gui.Parent and not state.Visible then
                    win.Visible = false
                end
            end)
        end
    end

    trackConn(connBag, closeBtn.MouseButton1Click:Connect(function()
        setVisible(false)
    end))

    local stopDrag = makeDraggable(win, titleBar)
    local stopResize = makeResizable(win, shadow, grip, MIN_W, MIN_H)

    trackConn(connBag, win:GetPropertyChangedSignal("Size"):Connect(function()
        if not state.Fullscreen and not state.Minimized then
            state.UserSize = win.Size
        end
    end))
    trackConn(connBag, win:GetPropertyChangedSignal("Position"):Connect(function()
        if not state.Fullscreen then
            state.UserPos = win.Position
        end
    end))

    if toggleKey and not IS_MOBILE then
        trackConn(connBag, UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == toggleKey then setVisible(not state.Visible) end
        end))
    end

    local bubble, bubbleShadow
    if showBubble then
        local bubbleSize = IS_MOBILE and 46 or 40
        bubble = new("TextButton", {
            Name = "ToggleBubble",
            BackgroundColor3 = Palette.Accent,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(bubbleSize, bubbleSize),
            Position = UDim2.new(0, 18, 0.5, -bubbleSize / 2),
            Text = "R",
            Font = Enum.Font.GothamBold,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = IS_MOBILE and 18 or 15,
            AutoButtonColor = false,
            ZIndex = 10,
            Parent = gui,
        })
        corner(bubble, bubbleSize / 2)
        stroke(bubble, Palette.AccentDim, 2, 0.15)

        bubbleShadow = new("Frame", {
            Name = "BubbleShadow",
            BackgroundColor3 = Palette.Shadow,
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(bubbleSize, bubbleSize),
            Position = bubble.Position + UDim2.fromOffset(3, 3),
            ZIndex = 9,
            Parent = gui,
        })
        corner(bubbleShadow, bubbleSize / 2)

        trackConn(connBag, bubble.MouseEnter:Connect(function()
            tween(bubble, 0.1, { BackgroundColor3 = Palette.AccentDim })
        end))
        trackConn(connBag, bubble.MouseLeave:Connect(function()
            tween(bubble, 0.1, { BackgroundColor3 = Palette.Accent })
        end))

        local stopBubbleDrag = makeDraggable(bubble, bubble, function(moved)
            if not moved then setVisible(not state.Visible) end
        end)

        trackConn(connBag, bubble:GetPropertyChangedSignal("Position"):Connect(function()
            bubbleShadow.Position = bubble.Position + UDim2.fromOffset(3, 3)
        end))

        table.insert(connBag, { Disconnect = stopBubbleDrag })
    end

    table.insert(connBag, { Disconnect = stopDrag })
    table.insert(connBag, { Disconnect = stopResize })

    local tabs, currentTab = {}, nil

    local api = {}
    api.Gui     = gui
    api.Window  = win
    api.Body    = body
    api.Content = scroll
    api.Palette = Palette
    api.State   = state
    api.Bubble  = bubble
    api.Tabs    = tabs

    api.Close   = function() setVisible(false) end
    api.Open    = function() setVisible(true) end
    api.Toggle  = function() setVisible(not state.Visible) end
    api.Destroy = function()
        disconnectAll(connBag)
        pcall(function() gui.Enabled = false end)
        pcall(function() gui:Destroy() end)
    end

    api.SetSize = function(nw, nh)
        local sz = UDim2.fromOffset(math.max(MIN_W, nw), math.max(MIN_H, nh))
        state.UserSize = sz
        applySize(sz, win.Position)
    end

    api.SelectTab = function(name)
        for _, t in ipairs(tabs) do
            if t.Button.Text == name then t:Select() return end
        end
    end

    function api:AddTab(name)
        name = name or "Tab"

        local btn = new("TextButton", {
            Name = "Tab_" .. name,
            BackgroundColor3 = Palette.Panel2,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 28),
            Font = Enum.Font.GothamMedium,
            Text = "  " .. name,
            TextColor3 = Palette.TextDim,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            ZIndex = 5,
            Parent = tabList,
        })
        corner(btn, 6)
        local btnStroke = stroke(btn, Palette.StrokeSoft, 1, 1)

        local btnAccent = new("Frame", {
            Name = "AccentBar",
            BackgroundColor3 = Palette.Accent,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0.5, -8),
            Size = UDim2.fromOffset(2, 16),
            ZIndex = 6,
            Visible = false,
            Parent = btn,
        })
